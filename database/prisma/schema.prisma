// ============================================================================
// Prisma Schema for VoiceOrder AI (PostgreSQL / Supabase)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductUnit {
  kg
  g
  litre
  ml
  piece
  packet
  dozen
  box
  bottle
  bundle
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMode {
  CASH
  UPI_QR
  CREDIT_UDHAAR
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
}

model Shop {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(255)
  ownerName         String       @map("owner_name") @db.VarChar(255)
  phone             String       @unique @db.VarChar(20)
  upiId             String?      @map("upi_id") @db.VarChar(100)
  address           String?      @db.Text
  deliveryRadiusKm  Decimal      @default(5.0) @map("delivery_radius_km") @db.Decimal(5, 2)
  deliveryFeeFixed  Decimal      @default(0.0) @map("delivery_fee_fixed") @db.Decimal(10, 2)
  deliveryFreeAbove Decimal      @default(500.0) @map("delivery_free_above") @db.Decimal(10, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  categories        Category[]
  products          Product[]
  customers         Customer[]
  orders            Order[]

  @@map("shops")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @map("shop_id") @db.Uuid
  name      String    @db.VarChar(100)
  hindiName String?   @map("hindi_name") @db.VarChar(100)
  slug      String    @db.VarChar(100)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([shopId, slug])
  @@map("categories")
}

model Product {
  id               String         @id @default(uuid()) @db.Uuid
  shopId           String         @map("shop_id") @db.Uuid
  categoryId       String?        @map("category_id") @db.Uuid
  name             String         @db.VarChar(255)
  hindiName        String?        @map("hindi_name") @db.VarChar(255)
  aliases          String[]       @default([])
  brand            String?        @db.VarChar(150)
  barcode          String?        @db.VarChar(100)
  description      String?        @db.Text
  
  unit             ProductUnit    @default(piece)
  unitStep         Decimal        @default(1.0) @map("unit_step") @db.Decimal(10, 3)
  mrp              Decimal        @db.Decimal(10, 2)
  sellingPrice     Decimal        @map("selling_price") @db.Decimal(10, 2)
  
  // Stock tracking - Automatically decremented on order
  availableStock   Decimal        @default(0.0) @map("available_stock") @db.Decimal(10, 2)
  soldCount        Decimal        @default(0.0) @map("sold_count") @db.Decimal(10, 2)
  minStockAlert    Decimal        @default(5.0) @map("min_stock_alert") @db.Decimal(10, 2)
  isAvailable      Boolean        @default(true) @map("is_available")
  
  // Image metadata: Fixed aspect ratio and count
  primaryImageUrl  String?        @map("primary_image_url") @db.Text
  imageAspectRatio String         @default("1:1") @map("image_aspect_ratio") @db.VarChar(10)
  imageCount       Int            @default(1) @map("image_count")
  
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category         Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  orderItems       OrderItem[]

  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  imageUrl    String   @map("image_url") @db.Text
  aspectRatio String   @default("1:1") @map("aspect_ratio") @db.VarChar(10)
  displayOrder Int     @default(0) @map("display_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  name          String   @db.VarChar(255)
  phone         String   @db.VarChar(20)
  address       String?  @db.Text
  landmark      String?  @db.Text
  notes         String?  @db.Text
  creditBalance Decimal  @default(0.0) @map("credit_balance") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@unique([shopId, phone])
  @@map("customers")
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  orderNumber      Int           @default(autoincrement()) @unique @map("order_number")
  shopId           String        @map("shop_id") @db.Uuid
  customerId       String?       @map("customer_id") @db.Uuid
  
  customerName     String        @map("customer_name") @db.VarChar(255)
  customerPhone    String        @map("customer_phone") @db.VarChar(20)
  deliveryAddress  String        @map("delivery_address") @db.Text
  
  audioUrl         String?       @map("audio_url") @db.Text
  rawTranscript    String?       @map("raw_transcript") @db.Text
  detectedLanguage String        @default("hi-IN") @map("detected_language") @db.VarChar(20)
  isVoiceOrder     Boolean       @default(true) @map("is_voice_order")
  
  subtotal         Decimal       @default(0.0) @db.Decimal(10, 2)
  deliveryFee      Decimal       @default(0.0) @map("delivery_fee") @db.Decimal(10, 2)
  discount         Decimal       @default(0.0) @db.Decimal(10, 2)
  totalAmount      Decimal       @default(0.0) @map("total_amount") @db.Decimal(10, 2)
  
  status           OrderStatus   @default(PLACED)
  paymentMode      PaymentMode   @default(CASH) @map("payment_mode")
  paymentStatus    PaymentStatus @default(UNPAID) @map("payment_status")
  
  rating           Int?
  feedbackNotes    String?       @map("feedback_notes") @db.Text
  
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  shop             Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  productId   String?     @map("product_id") @db.Uuid
  
  productName String      @map("product_name") @db.VarChar(255)
  unit        ProductUnit
  quantity    Decimal     @db.Decimal(10, 2)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal     @map("total_price") @db.Decimal(10, 2)
  
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
