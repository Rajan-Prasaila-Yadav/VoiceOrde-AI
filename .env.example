# ============================================================================
# Environment Variables for VoiceOrder AI
# ============================================================================

# Database (PostgreSQL / Supabase connection pooling)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Gnani AI API Configuration
# Get your API keys and check credits (5,000 challenge credits) at https://app.gnani.ai
GNANI_API_KEY="your-gnani-api-key"
GNANI_API_BASE_URL="https://api.vachana.ai"

# Gnani Service Endpoints (Vachana Speech Platform)
GNANI_TIMBRE_TTS_URL="https://api.vachana.ai/api/v1/tts/inference"
GNANI_PRISMA_STT_URL="https://api.vachana.ai/stt/v3/batch/jobs"
GNANI_EVON_LLM_URL="https://api.vachana.ai/v1/chat/completions"

# Application Settings
NEXT_PUBLIC_DEFAULT_SHOP_ID="00000000-0000-0000-0000-000000000001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
